# =============================================================================
# Trilha.ai — variáveis de ambiente
# =============================================================================
# No Google AI Studio, configure estes valores em Settings -> Secrets.
# Nunca commite o arquivo .env.
#
# Obrigatória: usada apenas no servidor (Route Handlers /api/gemini/*).
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Opcional: modelo padrão do OpenRouter. Se ficar vazio, usa "openrouter/free".
# Prefira o roteador "openrouter/free": ele escolhe um modelo gratuito
# disponível. Evite fixar modelos ":free" específicos, que podem responder 429.
OPENROUTER_MODEL="openrouter/free"

# Opcional: URL pública da aplicação. No AI Studio, APP_URL é injetada
# automaticamente pela plataforma; NEXT_PUBLIC_APP_URL tem prioridade.
NEXT_PUBLIC_APP_URL=""

# =============================================================================
# Otimizações de tokens
# =============================================================================

# Modelos pinados por papel (opcional). Pinar é pré-requisito para prompt
# caching e para avaliação reproduzível. Vazio = usa OPENROUTER_MODEL.
OPENROUTER_MODEL_CURRICULUM=""
OPENROUTER_MODEL_CONTENT=""

# Currículo em uma única chamada (40 tópicos em TOON tabular). "0" restaura o
# pipeline legado de 3 agentes (list-topics → curate-references →
# structure-roadmap).
NEXT_PUBLIC_CURRICULUM_V2="1"

# cite-or-drop: só mantém fontes da allowlist que respondem com sucesso.
# "0" restaura a checagem antiga (descarta apenas 404/410).
STRICT_SOURCES="1"

# Loga tokens de entrada/saída/cache por chamada de IA ("1" liga).
LLM_USAGE_LOG=""
