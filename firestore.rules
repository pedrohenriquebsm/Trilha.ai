rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Modelo de dados
    // ===============================================================
    // users/{userId}: name, email, role, plan, credits
    // roadmaps/{roadmapId}: title, originalTopic, mode, visibility,
    //                       authorId, createdAt, ...
    // roadmaps/{roadmapId}/topics/{topicId}: roadmapId, title, level,
    //                       order, content, sources, ...
    // userProgress/{progressId}: userId, topicId, roadmapId, status
    //
    // Regras de crédito:
    // - o cliente nunca pode AUMENTAR credits nem trocar plan/role;
    // - o cliente pode apenas decrementar 1 crédito ao criar uma trilha.
    //   A criação atômica é feita em uma transação no cliente.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'plan', 'credits']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() < 320 &&
             data.role in ['user', 'admin'] &&
             data.plan in ['free', 'pro'] &&
             data.credits is number && data.credits >= 0 && data.credits <= 100000;
    }

    function isValidRoadmap(data) {
      return data.keys().hasAll(['title', 'originalTopic', 'mode', 'visibility', 'authorId', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.originalTopic is string && data.originalTopic.size() > 0 &&
             data.mode in ['ai-driven', 'research'] &&
             data.visibility in ['public', 'private'] &&
             data.authorId is string && data.createdAt is timestamp;
    }

    function isValidTopic(data, roadmapId) {
      return data.keys().hasAll(['roadmapId', 'title', 'level', 'order']) &&
             data.roadmapId is string && data.roadmapId == roadmapId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.level is number && data.level >= 0 && data.level <= 4 &&
             data.order is number && data.order >= 0;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'topicId', 'roadmapId', 'status']) &&
             data.userId is string && data.topicId is string &&
             data.roadmapId is string &&
             data.status in ['not-started', 'in-progress', 'completed'];
    }

    function canReadRoadmap(roadmapId) {
      return get(/databases/$(database)/documents/roadmaps/$(roadmapId)).data.visibility == 'public' ||
             isOwner(get(/databases/$(database)/documents/roadmaps/$(roadmapId)).data.authorId) ||
             isAdmin();
    }

    function canWriteRoadmap(roadmapId) {
      return isAuthenticated() && (
        isOwner(get(/databases/$(database)/documents/roadmaps/$(roadmapId)).data.authorId) ||
        isAdmin()
      );
    }

    // ===============================================================
    // Perfis
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Novos perfis sempre começam com 5 créditos, plano free e role user.
      allow create: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.plan == 'free' &&
                       request.resource.data.credits == 5;

      // O dono não pode aumentar créditos, trocar plano, role ou e-mail.
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        isValidUser(request.resource.data) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.plan == resource.data.plan &&
                        request.resource.data.email == resource.data.email &&
                        (request.resource.data.credits == resource.data.credits ||
                         request.resource.data.credits == resource.data.credits - 1));

      // Deleting a profile is admin-only. If owners could delete their own
      // profile, they could recreate it with the initial 5 credits forever.
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Trilhas
    // ===============================================================
    match /roadmaps/{roadmapId} {
      allow read: if resource.data.visibility == 'public' ||
                     isOwner(resource.data.authorId) ||
                     isAdmin();

      allow create: if isAuthenticated() &&
                       isValidRoadmap(request.resource.data) &&
                       request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       isValidRoadmap(request.resource.data) &&
                       request.resource.data.authorId == resource.data.authorId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (isOwner(resource.data.authorId) || isAdmin());

      allow delete: if isAuthenticated() && (isOwner(resource.data.authorId) || isAdmin());

      match /topics/{topicId} {
        allow read: if canReadRoadmap(roadmapId);
        allow create, update: if canWriteRoadmap(roadmapId) &&
                                  isValidTopic(request.resource.data, roadmapId);
        allow delete: if canWriteRoadmap(roadmapId);
      }
    }

    // ===============================================================
    // Progresso
    // ===============================================================
    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;

      allow create: if isAuthenticated() &&
                       isValidProgress(request.resource.data) &&
                       request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       isValidProgress(request.resource.data) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.topicId == resource.data.topicId &&
                       request.resource.data.roadmapId == resource.data.roadmapId;

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
